{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Manifold Desktop",
  "version": "0.1.0",
  "identifier": "com.manifoldpowered.desktop",
  "build": {
    "beforeDevCommand": "npm run sidecar:prepare && npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run sidecar:prepare && npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self' https: data:; style-src 'self' 'unsafe-inline'"
    },
    "windows": [
      {
        "title": "Manifold Desktop",
        "width": 1100,
        "height": 720,
        "minWidth": 760,
        "minHeight": 520
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/icon.png", "icons/icon.ico"],
    "resources": {
      "resources/butler/": "butler/",
      "vendor/butler/v15.30.0/LICENSE": "licenses/butler-LICENSE",
      "vendor/butler/v15.30.0/NOTICE.md": "licenses/butler-NOTICE.md"
    }
  }
}
